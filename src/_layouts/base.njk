<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} - {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="{{ environment.baseUrl }}/assets/css/main.css">
</head>
<body>
  <header class="site-header">
    <a href="{{ environment.baseUrl }}/" class="site-title">{{ site.title }}</a>
  </header>

  <nav class="main-nav">
    <div class="nav-items">
      <a href="{{ environment.baseUrl }}/" class="nav-item{% if page.url == '/' %} active{% endif %}">
        <span class="nav-text">Home</span>
      </a>
      <a href="{{ environment.baseUrl }}/tutorials/" class="nav-item{% if '/tutorials/' in page.url %} active{% endif %}">
        <span class="nav-text">Tutorials</span>
      </a>
      <a href="{{ environment.baseUrl }}/assignments/" class="nav-item{% if '/assignments/' in page.url %} active{% endif %}">
        <span class="nav-text">Assignments</span>
      </a>
      <a href="{{ environment.baseUrl }}/resources/" class="nav-item{% if '/resources/' in page.url %} active{% endif %}">
        <span class="nav-text">Resources</span>
      </a>
      <a href="https://miro.com/app/board/uXjVLpMXxuo=/" class="nav-item external" target="_blank" rel="noopener noreferrer">
        <span class="nav-text">Miro</span>
      </a>
      <a href="https://drive.google.com/open?id=1G0S6lEdIPNVhYg3yqhHY72PjEwA_mfdH&usp=drive_fs" class="nav-item external" target="_blank" rel="noopener noreferrer">
        <span class="nav-text">Drive</span>
      </a>
      <a href="https://calendar.app.google/iLNgGU6wNgEsbXcY9" class="nav-item external" target="_blank" rel="noopener noreferrer">
        <span class="nav-text">Office Hours</span>
      </a>
    </div>
  </nav>

  <main class="site-main">
    {% if title and showTitle !== false %}
    <h1 class="page-title">{{ title }}</h1>
    {% endif %}
    {{ content | safe }}
  </main>
</body>
</html>
