<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} - {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
  <script defer src="https://analytics.adamvosburgh.com/script.js" data-website-id="75316050-d2da-48c7-8add-da205681a60a"></script>
</head>
<body>
  <header class="site-header">
    <a href="{{ '/' | url }}" class="site-title">{{ site.title }}</a>
  </header>

  <nav class="main-nav">
    <div class="nav-items">
      <a href="{{ '/' | url }}" class="nav-item{% if page.url == '/' %} active{% endif %}">
        <span class="nav-text">Home</span>
      </a>
      <a href="{{ '/tutorials/' | url }}" class="nav-item{% if '/tutorials/' in page.url %} active{% endif %}">
        <span class="nav-text">Tutorials</span>
      </a>
      <a href="{{ '/assignments/' | url }}" class="nav-item{% if '/assignments/' in page.url %} active{% endif %}">
        <span class="nav-text">Assignments</span>
      </a>
      <a href="{{ '/resources/' | url }}" class="nav-item{% if '/resources/' in page.url %} active{% endif %}">
        <span class="nav-text">Resources</span>
      </a>
      <a href="{{ '/projects/' | url }}" class="nav-item{% if '/projects/' in page.url %} active{% endif %}">
        <span class="nav-text">Student Work</span>
      </a>
      <a href="https://miro.com/app/board/uXjVGOegCuo=/?share_link_id=91061632439" class="nav-item external" target="_blank" rel="noopener noreferrer">
        <span class="nav-text">Miro</span>
      </a>
      <a href="https://drive.google.com/drive/folders/1wQgSIkj4sPorozZbUimPse9wyWo8tKbf?usp=sharing" class="nav-item external" target="_blank" rel="noopener noreferrer">
        <span class="nav-text">Drive</span>
      </a>
      <a href="https://calendar.app.google/xCpgY7ue27L9TWpC6" class="nav-item external" target="_blank" rel="noopener noreferrer">
        <span class="nav-text">Office Hours</span>
      </a>
    </div>
  </nav>

  <main class="site-main">
    {% if title and showTitle !== false %}
    <h1 class="page-title">{{ title }}</h1>
    {% endif %}
    {{ content | safe }}
  </main>
</body>
</html>
